//@version=6
strategy("Trend Join Daily - Research V2.0", overlay=true, initial_capital=60000, pyramiding=0, process_orders_on_close=false, commission_type=strategy.commission.percent, commission_value=0.03)

riskRupees = input.float(300, "Risk per trade (₹)", minval=50)
atrMult = input.float(2.0, "ATR Stop Multiplier", minval=0.5, step=0.1)
targetRR = input.float(1.5, "Target R:R", minval=0.5, step=0.1)
maxHold = input.int(20, "Maximum holding bars", minval=1)

ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rsi = ta.rsi(close, 14)
roc = ta.roc(close, 9)
atr = ta.atr(14)
mfMult = high == low ? 0.0 : ((close-low)-(high-close))/(high-low)
cmf = ta.sum(mfMult*volume, 20) / math.max(ta.sum(volume,20), 1)
[diPlus,diMinus,adx] = ta.dmi(14,14)

bull = close > ema50 and ema20 > ema50 and ema50 > ema200
momentum = rsi > 50 and roc > 0 and cmf > 0 and adx >= 16
freshReclaim = close > ema20 and close[1] <= ema20[1]
buySignal = bull and momentum and freshReclaim

stopDist = atr * atrMult
qty = stopDist > 0 ? math.floor(riskRupees / stopDist) : 0
if buySignal and strategy.position_size == 0 and qty > 0
    strategy.entry("LONG", strategy.long, qty=qty)

if strategy.position_size > 0
    stopPrice = strategy.position_avg_price - atrMult * atr
    targetPrice = strategy.position_avg_price + (strategy.position_avg_price-stopPrice)*targetRR
    strategy.exit("EXIT", "LONG", stop=stopPrice, limit=targetPrice)
    if ta.barssince(strategy.position_size == 0) >= maxHold
        strategy.close("LONG", comment="Time Exit")

plot(ema20, "EMA20", color=color.orange)
plot(ema50, "EMA50", color=color.blue)
plot(ema200, "EMA200", color=color.purple)
plotshape(buySignal, title="BUY Candidate", style=shape.labelup, text="BUY", color=color.green, textcolor=color.white, location=location.belowbar)
alertcondition(buySignal, "Trend Join BUY Candidate", "Trend Join BUY Candidate on {{ticker}} at {{close}}")
